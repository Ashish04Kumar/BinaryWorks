# Copy to .env (or add in Vercel → Settings → Environment Variables). Never commit the real values.

# Groq key for the Glitch and ScholarLens demos
GROQ_API_KEY=

# Umbrella's server (the companion brain): Glitch's home demo (lights, fan, AC, TV) runs on it.
# Only the Next.js server calls it (via /api/home). Unset or unreachable: the home demo shows "offline".
UMBRELLA_URL=http://127.0.0.1:8300

# Visitor analytics + /admin dashboard. "true" turns it on; anything else keeps it off.
# Off: nothing is tracked and /admin returns 404. Baked in at build time, so redeploy after changing it.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# /admin login (only needed when analytics is on)
ADMIN_EMAIL=
# "salt:hash" from: node -e 'const c=require("crypto");const s=c.randomBytes(16).toString("hex");console.log(s+":"+c.scryptSync(process.argv[1],s,64).toString("hex"))' 'your-password'
ADMIN_PASSWORD_HASH=
# any long random string: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
ADMIN_SECRET=
